<%= turbo_frame_tag "endpoint_list" do %>
  <div class="card space-y-0">
    <div class="flex items-center justify-between pb-3">
      <div>
        <h2 class="text-base font-semibold text-primary-container font-[Hanken_Grotesk]">Configured Endpoints</h2>
        <p class="text-xs text-slate-400 mt-0.5"><%= @endpoints.size %> endpoint<%= "s" unless @endpoints.size == 1 %> configured.</p>
      </div>
    </div>

    <% if @endpoints.any? %>
      <div class="space-y-2">
        <% @endpoints.each do |endpoint| %>
          <div class="flex items-center gap-3 p-3 border border-border rounded-default">
            <%# Status indicator %>
            <div class="flex-shrink-0">
              <div class="w-2 h-2 rounded-full <%= endpoint.active? ? 'bg-green-500' : 'bg-slate-300' %>" title="<%= endpoint.active? ? 'Active' : 'Inactive' %>"></div>
            </div>

            <%# Info %>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <p class="text-sm font-medium text-navy truncate"><%= endpoint.url %></p>
                <% unless endpoint.active? %>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-medium flex-shrink-0">Inactive</span>
                <% end %>
              </div>
              <div class="flex items-center gap-3 mt-0.5">
                <span class="text-[10px] text-slate-400 font-mono">Token: <%= endpoint.masked_token %></span>
                <% if endpoint.last_delivered_at %>
                  <span class="text-[10px] text-slate-400">Last: <%= time_ago_in_words(endpoint.last_delivered_at) %> ago</span>
                <% end %>
                <% if endpoint.consecutive_failures > 0 %>
                  <span class="text-[10px] text-amber-600 font-medium"><%= endpoint.consecutive_failures %> failure<%= "s" if endpoint.consecutive_failures > 1 %></span>
                <% end %>
              </div>
            </div>

            <%# Toggle active/inactive %>
            <%= button_to toggle_webhook_endpoint_path(endpoint), method: :patch, form: { data: { turbo_frame: "endpoint_list" } }, class: "flex-shrink-0", title: endpoint.active? ? "Deactivate" : "Activate" do %>
              <% if endpoint.active? %>
                <div class="w-5 h-5 rounded bg-primary-container flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
              <% else %>
                <div class="w-5 h-5 rounded border-2 border-border"></div>
              <% end %>
            <% end %>

            <%# Delete %>
            <%= button_to webhook_endpoint_path(endpoint), method: :delete, form: { data: { turbo_confirm: "Delete this webhook endpoint?" } }, class: "flex-shrink-0 text-slate-400 hover:text-error transition-colors", title: "Delete" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-slate-400 py-8 text-center">No webhook endpoints configured yet. Add one above.</p>
    <% end %>
  </div>
<% end %>
